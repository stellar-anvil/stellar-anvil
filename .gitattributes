# Normalize line endings to LF in the repository for all text files.
* text=auto eol=lf

# Rust and TOML source
*.rs    text eol=lf
*.toml  text eol=lf

# Markdown and YAML
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Shell scripts
*.sh    text eol=lf

# Windows batch files keep CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — never touch line endings
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.wasm  binary
